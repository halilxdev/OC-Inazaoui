{% extends 'admin.html.twig' %}

{% block admin %}
    <div class="d-flex justify-content-between align-items-center">
        <h1>Invités</h1>
        <a href="{{ path('admin_guests_add') }}" class="btn btn-primary">Ajouter</a>
    </div>
    <table class="table">
        <thead>
            <tr>
                <th>Titre</th>
                <th>Nombre de médias</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for user in users %}
                <tr>
                    <td {% if user.roles.0 == "ROLE_DISABLED" %}class="opacity-25"{% endif %}>{{ user.name }}</td>
                    <td {% if user.roles.0 == "ROLE_DISABLED" %}class="opacity-25"{% endif %}>{{ user.medias.count }} médias</td>
                    <td>
                        <a href="{{ path('admin_guests_toggle_access', {id: user.id}) }}"
                            {% if user.roles.0 == "ROLE_DISABLED" %}
                                onclick="return confirm('Voulez-vous activer l\'accès de {{ user.name|e('js') }} ?')"
                                class="btn px-2 py-1 bg-secondary text-light"
                            {% else %}
                                onclick="return confirm('Voulez-vous révoquer l\'accès de {{ user.name|e('js') }} ?')"
                                class="btn px-2 py-1 btn-warning"
                            {% endif %}
                        >
                            {% if user.roles.0 == "ROLE_DISABLED" %}
                                Activer l'accès
                            {% else %}
                                Révoquer l'accès
                            {% endif %}
                        </a>
                        <a href="{{ path('admin_guests_delete', {id: user.id}) }}" class="btn px-2 py-1 btn-danger" onclick="return confirm('Voulez-vous supprimer {{ user.name|e('js') }} ?')">Supprimer</a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    {% set totalPages = (total / 50)|round(0, 'ceil') %}

    <nav aria-label="Page navigation">
        <ul class="pagination">
            {% if page > 1 %}
                <li class="page-item">
                    <a class="page-link" href="{{ path('admin_guests_index', {page: 1}) }}">Première page</a>
                </li>
                <li class="page-item">
                    <a class="page-link" href="{{ path('admin_guests_index', {page: page - 1}) }}">Précédent</a>
                </li>
            {% endif %}

            {% for i in range(max(1, page - 3), min(totalPages, page + 3)) %}
                <li class="page-item {% if i == page %}active{% endif %}">
                    <a class="page-link" href="{{ path('admin_guests_index', {page: i}) }}">{{ i }}</a>
                </li>
            {% endfor %}

            {% if page < totalPages %}
                <li class="page-item">
                    <a class="page-link" href="{{ path('admin_guests_index', {page: page + 1}) }}">Suivant</a>
                </li>
                <li class="page-item">
                    <a class="page-link" href="{{ path('admin_guests_index', {page: totalPages}) }}">Dernière page</a>
                </li>
            {% endif %}
        </ul>
    </nav>
{% endblock %}